# Maintainer: Archmox Team <dev@archmox.acreetionos.org>

pkgname=archmox-proxmox-widget-toolkit
pkgver=1.0.0
pkgrel=1
pkgdesc="Proxmox widget toolkit (ExtJS-based UI components) - ported for Arch Linux"
arch=('x86_64')
url="https://archmox.acreetionos.org"
license=('AGPL3' 'LGPL2.1')
depends=( 'sencha-framework')
makedepends=('nodejs' 'npm' 'sass' 'sencha-cmd')
source=("git+https://git.proxmox.com/git/proxmox-widget-toolkit.git")
# Rolling port: track upstream master until pinned refs are validated.
sha256sums=('SKIP')

build() {
  cd "${srcdir}/proxmox-widget-toolkit"
  make
}

package() {
  cd "${srcdir}/proxmox-widget-toolkit"
  make DESTDIR="${pkgdir}" install
  if [[ -f LICENSE ]]; then
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
fi
}
