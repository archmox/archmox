# Maintainer: Archmox Team <dev@archmox.acreetionos.org>
pkgname=archmox-perl-authen-pam
_realname=Authen-PAM
pkgver=0.16
pkgrel=1
pkgdesc="PAM authentication bindings for Perl (PVE dependency)"
arch=('x86_64')
url="https://metacpan.org/dist/Authen-PAM"
license=('GPL' 'PerlArtistic')
depends=('glibc' 'pam')
makedepends=('perl-extutils-makemaker' 'make' 'gcc')
options=('!check' '!emptydirs')
source=("https://cpan.metacpan.org/authors/id/N/NI/NI-S/${_realname}-${pkgver}.tar.gz")
# Rolling port: upstream CPAN tarballs are immutable per version.
sha256sums=('SKIP')

build() {
  cd "${srcdir}/${_realname}-${pkgver}"
  unset PERL5LIB PERL_MM_OPT PERL_LOCAL_LIB_ROOT
  export PERL_MM_USE_DEFAULT=1 PERL_AUTOINSTALL=--skipdeps
  perl Makefile.PL INSTALLDIRS=vendor
  make
}

check() {
  cd "${srcdir}/${_realname}-${pkgver}"
  unset PERL5LIB PERL_MM_OPT PERL_LOCAL_LIB_ROOT
  export PERL_MM_USE_DEFAULT=1 PERL_AUTOINSTALL=--skipdeps
  # Skip: upstream test suite requires an interactive TTY conversation.
}

package() {
  cd "${srcdir}/${_realname}-${pkgver}"
  unset PERL5LIB PERL_MM_OPT PERL_LOCAL_LIB_ROOT
  make install INSTALLDIRS=vendor DESTDIR="${pkgdir}"
}
