# Maintainer: Archmox Team <dev@archmox.acreetionos.org>

pkgname=archmox-pve-eslint
pkgver=1.0.0
pkgrel=1
pkgdesc="Proxmox VE ESLint configuration - ported for Arch Linux"
arch=('any')
url="https://archmox.acreetionos.org"
license=('AGPL3')
depends=('nodejs' 'eslint')
makedepends=('npm')
source=("git+https://git.proxmox.com/git/pve-eslint.git")
# Rolling port: track upstream master until pinned refs are validated.
sha256sums=('SKIP')

package() {
  cd "${srcdir}/pve-eslint"
  local dest="${pkgdir}/usr/lib/node_modules/${pkgname}"
  # npm --prefix expects package.json to already exist at the destination;
  # copy the tree first, then resolve runtime deps into it.
  mkdir -p "${dest}"
  cp -a . "${dest}/"
  rm -rf "${dest}/.git"
  npm install --prefix "${dest}" --omit=dev --no-audit --no-fund
  if [[ -f LICENSE ]]; then
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  fi
}
