# Maintainer: Archmox Team <dev@archmox.acreetionos.org>

pkgname=archmox-pve-eslint
pkgver=1.0.0
pkgrel=1
pkgdesc="Proxmox VE ESLint configuration - ported for Arch Linux"
arch=('any')
url="https://archmox.acreetionos.org"
license=('AGPL3')
depends=('nodejs' 'eslint')
makedepends=('npm')
source=("git+https://git.proxmox.com/git/pve-eslint.git")
# Rolling port: track upstream master until pinned refs are validated.
sha256sums=('SKIP')

package() {
  cd "${srcdir}/pve-eslint"
  npm install --prefix "${pkgdir}/usr/lib/node_modules/${pkgname}" --production
  install -Dm644 package.json "${pkgdir}/usr/lib/node_modules/${pkgname}/package.json"
  install -Dm644 index.js "${pkgdir}/usr/lib/node_modules/${pkgname}/index.js" 2>/dev/null || true
  if [[ -f LICENSE ]]; then
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
fi
}
