# Maintainer: Archmox Team <dev@archmox.acreetionos.org>
# Contributor: Archmox Team <dev@archmox.acreetionos.org>

pkgname=archmox-proxmox-rs
pkgver=1.0.0
pkgrel=1
pkgdesc="Proxmox Rust libraries and bindings - ported for Arch Linux"
arch=('x86_64')
url="https://archmox.acreetionos.org"
license=('AGPL3')
depends=('glibc' 'gcc-libs' 'openssl' 'zlib' 'systemd-libs' 'libsodium' 'util-linux')
makedepends=('rust' 'cargo' 'pkg-config' 'cmake' 'make')
options=('!check')
source=("git+https://git.proxmox.com/git/proxmox.git")
# Rolling port: track upstream master until pinned refs are validated.
sha256sums=('SKIP')

build() {
  cd "${srcdir}/proxmox"
  cargo build --release
}

package() {
  cd "${srcdir}/proxmox"
  # The repo root is a virtual Cargo workspace; install binaries when the
  # root defines a package, otherwise ship the built artifacts as-is.
  if grep -q '^\[package\]' Cargo.toml; then
    cargo install --locked --root="${pkgdir}/usr" --path .
  else
    install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md" \
      2>/dev/null || true
  fi
  if [[ -f LICENSE ]]; then
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  fi
}
