# Maintainer: Archmox Team <dev@archmox.acreetionos.org>

pkgname=archmox-pve-lxc-syscalld
pkgver=1.0.0
pkgrel=1
pkgdesc="Proxmox VE LXC syscall daemon - ported for Arch Linux"
arch=('x86_64')
url="https://archmox.acreetionos.org"
license=('AGPL3')
depends=('glibc' 'libseccomp' 'lxc')
makedepends=('make' 'gcc' 'pkg-config' 'libseccomp')
source=("git+https://git.proxmox.com/git/pve-lxc-syscalld.git")
# Rolling port: track upstream master until pinned refs are validated.
sha256sums=('SKIP')

build() {
  cd "${srcdir}/pve-lxc-syscalld"
  make
}

package() {
  cd "${srcdir}/pve-lxc-syscalld"
  make DESTDIR="${pkgdir}" install
  if [[ -f LICENSE ]]; then
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
fi
}
