# Maintainer: Archmox Team <dev@archmox.acreetionos.org>

pkgname=archmox-pve-guest-common
pkgver=1.0.0
pkgrel=1
pkgdesc="Proxmox VE common guest management (VMs and containers) - ported for Arch Linux"
arch=('x86_64')
url="https://archmox.acreetionos.org"
license=('AGPL3')
depends=('archmox-pve-common' 'archmox-pve-storage' 'archmox-pve-firewall'
         'perl' 'perl-json' 'perl-libwww' 'perl-io-socket-ssl'
         'perl-net-ip' 'perl-xml-libxml' 'perl-filesys-df'
         'perl-string-shellquote' 'perl-linux-inotify2')
makedepends=('make' 'gcc' 'perl-module-build')
source=("git+https://git.proxmox.com/git/pve-guest-common.git")
# Rolling port: track upstream master until pinned refs are validated.
sha256sums=('SKIP')

build() {
  cd "${srcdir}/pve-guest-common"
  make
}

package() {
  cd "${srcdir}/pve-guest-common"
  make DESTDIR="${pkgdir}" install
  if [[ -f LICENSE ]]; then
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
fi
}
