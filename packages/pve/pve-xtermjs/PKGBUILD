# Maintainer: Archmox Team <dev@archmox.acreetionos.org>

pkgname=archmox-pve-xtermjs
pkgver=1.0.0
pkgrel=1
pkgdesc="Proxmox VE xterm.js terminal integration - ported for Arch Linux"
arch=('any')
url="https://archmox.acreetionos.org"
license=('AGPL3' 'MIT')
depends=('nodejs' 'xterm')
makedepends=('npm' 'make')
source=("git+https://git.proxmox.com/git/pve-xtermjs.git")
# Rolling port: track upstream master until pinned refs are validated.
sha256sums=('SKIP')

build() {
  cd "${srcdir}/pve-xtermjs"
  make
}

package() {
  cd "${srcdir}/pve-xtermjs"
  make DESTDIR="${pkgdir}" install
  if [[ -f LICENSE ]]; then
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
fi
}
