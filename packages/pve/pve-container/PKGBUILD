# Maintainer: Archmox Team <dev@archmox.acreetionos.org>

pkgname=archmox-pve-container
pkgver=1.0.0
pkgrel=1
pkgdesc="Proxmox VE LXC container management - ported for Arch Linux"
arch=('x86_64')
url="https://archmox.acreetionos.org"
license=('AGPL3')
depends=('archmox-pve-common' 'archmox-pve-guest-common' 'archmox-pve-storage'
         'archmox-pve-firewall' 'archmox-pve-access-control'
         'lxc' 'lxcfs' 'perl' 'perl-json' 'perl-libwww'
         'perl-net-ip' 'perl-io-socket-ssl' 'perl-xml-libxml'
         'perl-filesys-df' 'perl-string-shellquote'
         'archmox-perl-linux-inotify2' 'archmox-pve-lxc-syscalld')
makedepends=('make' 'gcc' 'perl-module-build')
source=("git+https://git.proxmox.com/git/pve-container.git")
# Rolling port: track upstream master until pinned refs are validated.
sha256sums=('SKIP')

build() {
  cd "${srcdir}/pve-container"
  make
}

package() {
  cd "${srcdir}/pve-container"
  make DESTDIR="${pkgdir}" install
  if [[ -f LICENSE ]]; then
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
fi
}
