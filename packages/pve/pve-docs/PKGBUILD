# Maintainer: Archmox Team <dev@archmox.acreetionos.org>

pkgname=archmox-pve-docs
pkgver=1.0.0
pkgrel=1
pkgdesc="Proxmox VE documentation - ported for Arch Linux"
arch=('any')
url="https://archmox.acreetionos.org"
license=('AGPL3')
depends=()
makedepends=('asciidoc' 'xmlto' 'docbook-xsl' 'libxml2' 'libxslt'
             'dblatex' 'w3m' 'python' 'make')
source=("git+https://git.proxmox.com/git/pve-docs.git")
# Rolling port: track upstream master until pinned refs are validated.
sha256sums=('SKIP')

build() {
  cd "${srcdir}/pve-docs"
  make
}

package() {
  cd "${srcdir}/pve-docs"
  make DESTDIR="${pkgdir}" install
  if [[ -f LICENSE ]]; then
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
fi
}
