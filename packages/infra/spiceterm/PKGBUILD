# Maintainer: Archmox Team <dev@archmox.acreetionos.org>

pkgname=archmox-spiceterm
pkgver=1.0.0
pkgrel=1
pkgdesc="SPICE terminal for Proxmox - ported for Arch Linux"
arch=('x86_64')
url="https://archmox.acreetionos.org"
license=('AGPL3')
depends=('glibc' 'spice-server' 'spice-protocol' 'libssl' 'zlib')
makedepends=('make' 'gcc' 'pkg-config')
source=("git+https://git.proxmox.com/git/spiceterm.git")
# Rolling port: track upstream master until pinned refs are validated.
sha256sums=('SKIP')

build() {
  cd "${srcdir}/spiceterm"
  make
}

package() {
  cd "${srcdir}/spiceterm"
  make DESTDIR="${pkgdir}" install
  if [[ -f LICENSE ]]; then
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
fi
}
