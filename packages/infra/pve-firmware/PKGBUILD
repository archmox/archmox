# Maintainer: Archmox Team <dev@archmox.acreetionos.org>

pkgname=archmox-pve-firmware
pkgver=1.0.0
pkgrel=1
pkgdesc="Proxmox VE firmware files - ported for Arch Linux"
arch=('any')
url="https://archmox.acreetionos.org"
license=('GPL2' 'BSD' 'MIT')
depends=()
makedepends=()
source=("git+https://git.proxmox.com/git/pve-firmware.git")
# Rolling port: track upstream master until pinned refs are validated.
sha256sums=('SKIP')

package() {
  cd "${srcdir}/pve-firmware"
  install -dm755 "${pkgdir}/usr/lib/firmware"
  cp -r * "${pkgdir}/usr/lib/firmware/" 2>/dev/null || true
  if [[ -f LICENSE ]]; then
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
fi
}
