# Maintainer: Archmox Team <dev@archmox.acreetionos.org>

pkgname=archmox-gfs2-utils
pkgver=1.0.0
pkgrel=1
pkgdesc="GFS2 filesystem utilities with Proxmox patches - ported for Arch Linux"
arch=('x86_64')
url="https://archmox.acreetionos.org"
license=('GPL2')
depends=('glibc' 'util-linux' 'libblkid' 'libnl' 'archmox-corosync-pve' 'pacemaker')
makedepends=('make' 'gcc' 'pkg-config' 'autoconf' 'automake' 'libtool')
source=("git+https://git.kernel.org/pub/scm/linux/kernel/git/gfs2/gfs2-utils.git")
# Rolling port: track upstream master until pinned refs are validated.
sha256sums=('SKIP')

build() {
  cd "${srcdir}/gfs2-utils"
  ./autogen.sh
  ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
  make
}

package() {
  cd "${srcdir}/gfs2-utils"
  make DESTDIR="${pkgdir}" install
  if [[ -f LICENSE ]]; then
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
fi
}
