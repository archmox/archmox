# Maintainer: Archmox Team <dev@archmox.acreetionos.org>

pkgname=archmox-dab
pkgver=1.0.0
pkgrel=1
pkgdesc="Debian Appliance Builder for Proxmox - ported for Arch Linux"
arch=('any')
url="https://archmox.acreetionos.org"
license=('AGPL3')
depends=('perl' 'perl-json' 'perl-libwww' 'perl-io-socket-ssl'
         'perl-xml-libxml' 'perl-template-toolkit'
         'perl-file-slurp' 'perl-datetime' 'archmox-perl-linux-inotify2'
         'perl-filesys-df' 'wget' 'debootstrap' 'mmdebstrap'
         'tar' 'xz' 'gzip' 'bzip2')
makedepends=('make' 'gcc' 'perl-module-build')
source=("git+https://git.proxmox.com/git/dab.git")
# Rolling port: track upstream master until pinned refs are validated.
sha256sums=('SKIP')

build() {
  cd "${srcdir}/dab"
  make
}

package() {
  cd "${srcdir}/dab"
  make DESTDIR="${pkgdir}" install
  if [[ -f LICENSE ]]; then
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
fi
}
