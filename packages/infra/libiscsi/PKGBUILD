# Maintainer: Archmox Team <dev@archmox.acreetionos.org>

pkgname=archmox-libiscsi
pkgver=1.0.0
pkgrel=1
pkgdesc="iSCSI library with Proxmox patches - ported for Arch Linux"
arch=('x86_64')
url="https://archmox.acreetionos.org"
license=('GPL2' 'LGPL2.1')
depends=('glibc' 'openssl' 'libxml2')
makedepends=('make' 'gcc' 'pkg-config')
source=("git+https://github.com/sahlberg/libiscsi.git")
# Rolling port: track upstream master until pinned refs are validated.
sha256sums=('SKIP')

build() {
  cd "${srcdir}/libiscsi"
  ./configure --prefix=/usr
  make
}

package() {
  cd "${srcdir}/libiscsi"
  make DESTDIR="${pkgdir}" install
  if [[ -f LICENSE ]]; then
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
fi
}
