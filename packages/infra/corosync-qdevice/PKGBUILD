# Maintainer: Archmox Team <dev@archmox.acreetionos.org>

pkgname=archmox-corosync-qdevice
pkgver=1.0.0
pkgrel=1
pkgdesc="Corosync QDevice (quorum device) - ported for Arch Linux"
arch=('x86_64')
url="https://archmox.acreetionos.org"
license=('BSD')
depends=('archmox-corosync-pve' 'glibc' 'libqb' 'libxml2')
makedepends=('make' 'gcc' 'pkg-config' 'autoconf' 'automake' 'libtool')
source=("git+https://git.proxmox.com/git/corosync-qdevice.git")
# Rolling port: track upstream master until pinned refs are validated.
sha256sums=('SKIP')

build() {
  cd "${srcdir}/corosync-qdevice"
  ./autogen.sh
  ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
  make
}

package() {
  cd "${srcdir}/corosync-qdevice"
  make DESTDIR="${pkgdir}" install
  if [[ -f LICENSE ]]; then
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
fi
}
