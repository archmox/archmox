# Maintainer: Archmox Team <dev@archmox.acreetionos.org>

pkgname=archmox-vncterm
pkgver=1.0.0
pkgrel=1
pkgdesc="VNC terminal for Proxmox - ported for Arch Linux"
arch=('x86_64')
url="https://archmox.acreetionos.org"
license=('AGPL3')
depends=('glibc' 'libvncserver' 'libssl' 'libcrypto' 'zlib' 'lzo')
makedepends=('make' 'gcc' 'pkg-config' 'cmake')
source=("git+https://git.proxmox.com/git/vncterm.git")
# Rolling port: track upstream master until pinned refs are validated.
sha256sums=('SKIP')

build() {
  cd "${srcdir}/vncterm"
  make
}

package() {
  cd "${srcdir}/vncterm"
  make DESTDIR="${pkgdir}" install
  if [[ -f LICENSE ]]; then
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
fi
}
