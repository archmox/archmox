# Maintainer: Archmox Team <dev@archmox.acreetionos.org>

pkgname=archmox-redhat-cluster-pve
pkgver=1.0.0
pkgrel=1
pkgdesc="Red Hat cluster suite with Proxmox patches - ported for Arch Linux"
arch=('x86_64')
url="https://archmox.acreetionos.org"
license=('GPL2' 'LGPL2.1')
depends=('glibc' 'libxml2' 'libqb' 'archmox-corosync-pve' 'nss')
makedepends=('make' 'gcc' 'pkg-config' 'autoconf' 'automake' 'libtool')
source=("git+https://git.proxmox.com/git/redhat-cluster-pve.git")
# Rolling port: track upstream master until pinned refs are validated.
sha256sums=('SKIP')

build() {
  cd "${srcdir}/redhat-cluster-pve"
  ./autogen.sh
  ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
  make
}

package() {
  cd "${srcdir}/redhat-cluster-pve"
  make DESTDIR="${pkgdir}" install
  if [[ -f LICENSE ]]; then
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
fi
}
