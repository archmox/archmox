# Maintainer: Archmox Team <dev@archmox.acreetionos.org>

pkgname=archmox-lvm
pkgver=1.0.0
pkgrel=1
pkgdesc="LVM2 with Proxmox patches - ported for Arch Linux"
arch=('x86_64')
url="https://archmox.acreetionos.org"
license=('GPL2')
depends=('glibc' 'device-mapper' 'util-linux'
         'util-linux' 'readline' 'udev' 'thin-provisioning-tools')
makedepends=('make' 'gcc' 'pkg-config' 'autoconf' 'automake')
source=("git+https://sourceware.org/git/lvm2.git")
# Rolling port: track upstream master until pinned refs are validated.
sha256sums=('SKIP')

build() {
  cd "${srcdir}/lvm2"
  ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
    --enable-udev_rules --enable-udev_sync --enable-dmeventd
  make
}

package() {
  cd "${srcdir}/lvm2"
  make DESTDIR="${pkgdir}" install
  if [[ -f LICENSE ]]; then
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
fi
}
