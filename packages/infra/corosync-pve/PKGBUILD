# Maintainer: Archmox Team <dev@archmox.acreetionos.org>

pkgname=archmox-corosync-pve
pkgver=1.0.0
pkgrel=1
pkgdesc="Corosync cluster engine with Proxmox patches - ported for Arch Linux"
arch=('x86_64')
url="https://archmox.acreetionos.org"
license=('BSD')
depends=('glibc' 'libqb' 'libxml2' 'libsasl' 'lzo' 'nss')
makedepends=('make' 'gcc' 'pkg-config' 'autoconf' 'automake' 'libtool')
source=("git+https://github.com/corosync/corosync.git")
# Rolling port: track upstream master until pinned refs are validated.
sha256sums=('SKIP')

build() {
  cd "${srcdir}/corosync"
  ./autogen.sh
  ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
  make
}

package() {
  cd "${srcdir}/corosync"
  make DESTDIR="${pkgdir}" install
  if [[ -f LICENSE ]]; then
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
fi
}
