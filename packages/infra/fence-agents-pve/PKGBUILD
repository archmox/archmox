# Maintainer: Archmox Team <dev@archmox.acreetionos.org>

pkgname=archmox-fence-agents-pve
pkgver=1.0.0
pkgrel=1
pkgdesc="Fence agents for Proxmox VE - ported for Arch Linux"
arch=('any')
url="https://archmox.acreetionos.org"
license=('GPL2')
depends=('perl' 'perl-libwww' 'perl-json' 'perl-io-socket-ssl'
         'perl-net-ip' 'perl-xml-libxml' 'perl-crypt-openssl-rsa' 'fence-agents')
makedepends=('make')
source=("git+https://github.com/ClusterLabs/fence-agents.git")
# Rolling port: track upstream master until pinned refs are validated.
sha256sums=('SKIP')

build() {
  cd "${srcdir}/fence-agents"
  make
}

package() {
  cd "${srcdir}/fence-agents"
  make DESTDIR="${pkgdir}" install
  if [[ -f LICENSE ]]; then
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
fi
}
