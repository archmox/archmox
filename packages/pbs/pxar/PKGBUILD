# Maintainer: Archmox Team <dev@archmox.acreetionos.org>

pkgname=archmox-pxar
pkgver=1.0.0
pkgrel=1
pkgdesc="Proxmox file archive format (pxar) - ported for Arch Linux"
arch=('x86_64')
url="https://archmox.acreetionos.org"
license=('AGPL3')
depends=('glibc' 'gcc-libs' 'openssl' 'zlib' 'libsodium' 'zstd'
         'lz4' 'xz')
makedepends=('rust' 'cargo' 'pkg-config' 'make')
source=("git+https://git.proxmox.com/git/pxar.git")
# Rolling port: track upstream master until pinned refs are validated.
sha256sums=('SKIP')

build() {
  cd "${srcdir}/pxar"
  cargo build --release
}

check() {
  cd "${srcdir}/pxar"
  cargo test --release
}

package() {
  cd "${srcdir}/pxar"
  cargo install --locked --root="${pkgdir}/usr" --path .
  if [[ -f LICENSE ]]; then
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
fi
}
