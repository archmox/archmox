# Maintainer: Archmox Team <dev@archmox.acreetionos.org>

pkgname=archmox-proxmox-backup-qemu
pkgver=1.0.0
pkgrel=1
pkgdesc="Proxmox Backup QEMU integration - ported for Arch Linux"
arch=('x86_64')
url="https://archmox.acreetionos.org"
license=('AGPL3')
depends=('archmox-proxmox-backup' 'archmox-pxar' 'qemu' 'glibc' 'gcc-libs')
makedepends=('rust' 'cargo' 'make' 'gcc' 'pkg-config')
source=("git+https://git.proxmox.com/git/proxmox-backup-qemu.git")
# Rolling port: track upstream master until pinned refs are validated.
sha256sums=('SKIP')

build() {
  cd "${srcdir}/proxmox-backup-qemu"
  cargo build --release
}

package() {
  cd "${srcdir}/proxmox-backup-qemu"
  cargo install --locked --root="${pkgdir}/usr" --path .
  if [[ -f LICENSE ]]; then
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
fi
}
