# Maintainer: Archmox Team <dev@archmox.acreetionos.org>

pkgname=archmox-proxmox-fuse-rs
pkgver=1.0.0
pkgrel=1
pkgdesc="Proxmox FUSE filesystem (Rust) - ported for Arch Linux"
arch=('x86_64')
url="https://archmox.acreetionos.org"
license=('AGPL3')
depends=('glibc' 'gcc-libs' 'fuse3' 'libsodium' 'zstd' 'lz4')
makedepends=('rust' 'cargo' 'pkg-config' 'make' 'fuse3')
source=("git+https://git.proxmox.com/git/proxmox-fuse.git")
# Rolling port: track upstream master until pinned refs are validated.
sha256sums=('SKIP')

build() {
  cd "${srcdir}/proxmox-fuse"
  cargo build --release
}

check() {
  cd "${srcdir}/proxmox-fuse"
  cargo test --release
}

package() {
  cd "${srcdir}/proxmox-fuse"
  cargo install --locked --root="${pkgdir}/usr" --path .
  if [[ -f LICENSE ]]; then
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
fi
}
